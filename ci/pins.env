# The production store and the graphiti test sources, pinned exactly
# (homelab#332). Sourced by the scripts in this directory. 🚨 Keep each store
# value equal to production, and equal to sirantd/cognee-age-adapter: both
# graphs live in one PostgreSQL app. A gate that blesses the driver against a
# store nobody runs proves less than it says.

# The TrueNAS catalog app `postgres` (app version 1.5.46, image_selector
# v18_pgvector_image), read from the running app on 2026-11-08.
POSTGRES_IMAGE='pgvector/pgvector:0.8.7-pg18-trixie@sha256:5895949dfcdf308eb0cd31c950c93c14895c77f33fbedfecf1fa511ab1d4bcd2'

# The PGDG package whose files production mounts at /opt/age. Its version
# string says rc0, but its source tree is the ASF 1.8.0 release file for file:
# verify-age-source.sh proves that on every run.
AGE_DEB_URL='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0-2.pgdg13%2B1_amd64.deb'
AGE_DEB_SHA256='13311da728eb7673249d94c6d1696dfae23cb481a62a884c4b0f5a1fcfed75d2'

# The same package for arm64, for a laptop only (AGE_ARCH=arm64 ci/fetch-age.sh).
# CI and production use the amd64 package above.
AGE_DEB_URL_ARM64='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0-2.pgdg13%2B1_arm64.deb'
AGE_DEB_SHA256_ARM64='597f213e49cd14f339f7947a6b7fadb8c83091967413d825388bb02fafb0ec34'

# The source of that package, and the ASF release it must equal. The ASF URL is
# the permanent archive: downloads.apache.org drops a release when the next one
# comes out.
AGE_ORIG_URL='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0.orig.tar.gz'
AGE_ORIG_SHA256='c9036f9fb6fe545aa20e333743c661810966288cda9922ac89f4d82d9ee6e99b'
AGE_DEBIAN_URL='https://apt.postgresql.org/pub/repos/apt/pool/main/p/postgresql-18-age/postgresql-18-age_1.8.0~rc0-2.pgdg13%2B1.debian.tar.xz'
AGE_DEBIAN_SHA256='d514f6af0e9d6ef059f2cff50a13974a2c9b5fba1d3445ec167ae6587d75dfd5'
AGE_ASF_URL='https://archive.apache.org/dist/age/PG18/1.8.0/apache-age-1.8.0-src.tar.gz'
AGE_ASF_SHA512='8103dc6a4daec0441c2bdfe4e456be619d04526efa5c4e1a5148a29d7e6359e5df7d9a1fabbc6a6a08f6229c4d6f8634b7bf3554eca8ffb58550382542279866'

# graphiti-core's own test suite. The PyPI wheel holds no tests, so CI takes them
# from the source tree of the release tag v0.31.2 (commit d72407d), and
# tests/test_suite_pins.py checks that its version equals the installed
# graphiti-core. 🚨 A bump of graphiti-core moves these two lines too.
GRAPHITI_REF='d72407dcedac911e1be9fc15b55e8c05a3efcc36'
GRAPHITI_SRC_URL="https://codeload.github.com/getzep/graphiti/tar.gz/${GRAPHITI_REF}"
GRAPHITI_SRC_SHA256='2260ee2ec7d6cbf6e111b2b6b1efcbc1feb531d23d4b7536a02d9ab5e64d95bf'
